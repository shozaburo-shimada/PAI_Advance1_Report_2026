# ロボットのポート確認コマンド
# lerobot-find-port
# カメラ番号の確認コマンド
# lerobot-find-cameras opencv

FOLLOWER_PORT=/dev/tty.usbmodemXXXXXXXX
LEADER_PORT=/dev/tty.usbmodemYYYYYYYY
FOLLOWER_ID=my_awesome_follower_arm
LEADER_ID=my_awesome_leader_arm
WRIST_CAMERA_INDEX=0
UP_CAMERA_INDEX=1
HF_USER=$(NO_COLOR=1 hf auth whoami --quiet)